# GEMINI_API_KEY: Required for server-side Gemini AI educational explanations.
# AI Studio injects this at runtime from user secrets. Keep strictly server-side.
GEMINI_API_KEY=

# APP_URL: The primary URL where SmartGrowth AI is hosted.
APP_URL=

# SESSION_SECRET: HMAC signing secret (min 16 chars) for user session tokens.
# Optional in preview (falls back to an in-memory random 32-byte key if unset).
SESSION_SECRET=

# DATABASE_PATH: Optional SQLite file path (defaults to ./data/smartgrowth.db).
DATABASE_PATH=

# ENABLE_DEMO_ACCOUNTS: Set to "true" for sandbox demos, or "false" for real-user pilot launch.
ENABLE_DEMO_ACCOUNTS=true

# ADMIN_EMAIL: Verified Google/Firebase email granted Admin & Data Lab access.
ADMIN_EMAIL=fsonsdigitalmarketing@gmail.com

# CORS_ORIGIN: Comma-separated allowed frontend origins when hosting static dist/ on cPanel separately from the Node AI backend.
# Example: https://app.yourdomain.com,https://pilot.yourdomain.com
CORS_ORIGIN=

# VITE_API_BASE_URL: Build-time frontend variable pointing to the hosted Node AI backend URL when frontend is static on cPanel.
# Leave empty when frontend and backend share the same origin.
VITE_API_BASE_URL=
