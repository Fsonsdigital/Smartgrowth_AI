# GEMINI_API_KEY: Required for server-side Gemini AI educational explanations.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SESSION_SECRET: HMAC signing secret for user session tokens.
# Optional in preview (falls back to an in-memory random 32-byte key if unset).
SESSION_SECRET=

# DATABASE_PATH: Optional SQLite file path (defaults to ./data/smartgrowth.db).
DATABASE_PATH=

# ENABLE_DEMO_ACCOUNTS: Set to "true" to allow one-click synthetic demo sign-in in preview/sandbox environments.
ENABLE_DEMO_ACCOUNTS=true
